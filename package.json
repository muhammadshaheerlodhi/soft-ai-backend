{
  "name": "soft-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for Soft AI, the assistant inside Softoras ERP",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
