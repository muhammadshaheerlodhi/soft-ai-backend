# Copy to .env for local development. NEVER commit .env, never paste real keys in chats.
# Values below are for the LOCAL Supabase in Docker only.

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Soft AI connects as its own restricted role (see db/local/enable-local-service-login.sql).
# Production: the database owner sets the real password; it is stored only in Railway.
DATABASE_URL=postgres://soft_ai_service:local-dev-only@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10

# Supabase project URL (local: http://127.0.0.1:54321). Used to check who signed a login token.
SUPABASE_URL=http://127.0.0.1:54321

# How login tokens are checked:
#   jwks   - projects using Supabase "JWT signing keys" (public keys, recommended)
#   secret - older projects that sign tokens with the shared JWT secret
AUTH_JWT_MODE=secret
# Only for AUTH_JWT_MODE=secret. Local Supabase prints it on `npx supabase start`.
SUPABASE_JWT_SECRET=

# Websites allowed to call this API from the browser (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI provider: "gemini" (real) or "fake" (local testing only; refused in production).
AI_PROVIDER=gemini
# Your OWN key from Google AI Studio. Put the real value ONLY in .env, never here.
GEMINI_API_KEY=
# Model names change over time; check the list your key can use before changing.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Hidden "thinking" is billed as output. MINIMAL keeps simple chat cheap.
# MINIMAL | LOW | MEDIUM | HIGH | DEFAULT (model's own default)
GEMINI_THINKING_LEVEL=MINIMAL

# AI calls: how long to wait, and the longest reply allowed INCLUDING thinking
# (also sizes the credit hold).
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1024

# Chat
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_CHARS=24000

# Request limits for AI routes (starting points; tune with real usage).
RATE_USER_PER_MINUTE=20
RATE_USER_PER_DAY=500
RATE_ORG_PER_MINUTE=120
